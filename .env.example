# ---------- Core ----------
DB_PATH=data/monitor.db
ENABLE_SCHEDULER=true
SEED_DEMO=true              # add a few demo monitors on first start
FAILURE_THRESHOLD=3         # consecutive failures before a DOWN alert
RETENTION_DAYS=30           # old check rows are purged automatically

# ---------- Alerts (all optional; console + DB alerts are always on) ----------
ALERT_WEBHOOK_URL=          # Slack / Discord / any webhook that accepts JSON
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# ---------- AI analysis (optional) ----------
# Fill in ANY ONE key. Works with whichever you provide.
AI_PROVIDER=auto            # auto | anthropic | openai | gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=             # GOOGLE_API_KEY also accepted

# Model names are configurable because providers rename/retire models.
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-flash-latest

AI_MIN_FAILURES=3           # below this many failures AI is NOT called (not enough data)
AI_TIMEOUT=60
